#!/system/bin/sh
# Mark a manual configuration change; users apply it by restarting the service.

events=$1
monitor_dir=$2
monitor_file=$3

SCRIPTS_DIR=$(dirname "$0")
. "$SCRIPTS_DIR/lib.sh"
load_config

case "$monitor_file" in
  ''|*.new|*.tmp|*.bak) exit 0 ;;
esac

changed_path=""
if [ "$monitor_dir" = "$user_scripts_path" ]; then
  case "$monitor_file" in
    sing-box.config|tproxy.conf|subscription.json|force_proxy_app.txt|force_bypass_app.txt) changed_path="$monitor_dir/$monitor_file" ;;
  esac
elif [ "$monitor_dir" = "$user_inbounds_path" ]; then
  [ "$monitor_file" = "${proxy_mode}.json" ] && changed_path="$monitor_dir/$monitor_file"
elif [ "$monitor_dir" = "$config_root" ]; then
  [ "$monitor_file" = "proxy_package_name" ] && changed_path="$monitor_dir/$monitor_file"
else
  # resolve 会因活动配置被删除而失败, 但 active_config_path 已先行赋值;
  # 单独比较路径, 让纯删除也能产生提醒 (否则下次重启静默失败)。
  resolve_active_config >/dev/null 2>&1
  [ "$monitor_dir/$monitor_file" = "$active_config_path" ] && changed_path="$active_config_path"
fi

[ -n "$changed_path" ] || exit 0
if [ -f "$run_path/.start_marker" ] && [ -e "$changed_path" ] && [ ! "$changed_path" -nt "$run_path/.start_marker" ]; then
  exit 0
fi

mkdir "$run_path" 2>/dev/null
[ -f "$run_path/.config-changed" ] && exit 0
: >"$run_path/.config-changed"
