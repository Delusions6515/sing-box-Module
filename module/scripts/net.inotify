#!/system/bin/sh
# Rebuild local-address bypass rules after network interfaces change.
# Monitored dir is /data/misc/net (sysfs does not support inotify).

events=$1

# Only respond to write events; netd touches the dir frequently.
case "$events" in
  *w*) : ;;
  *) exit 0 ;;
esac

SCRIPTS_DIR=$(dirname "$0")
. "$SCRIPTS_DIR/lib.sh"
load_config

# The rules are installed only while the AndroidTProxyShell adapter has an
# active runtime configuration. Rebuilding a dedicated chain avoids appending
# duplicate rules to AndroidTProxyShell's BYPASS_IP chains.
sh "$SCRIPTS_DIR/tproxy.sh" refresh-local-bypass \
  >>"$run_path/run.log" 2>>"$run_path/run_error.log"
