#!/system/bin/sh
# ============================================================
# sing-box for Android 模块配置
# 本文件只包含模块特有配置 (路径 / 内核渠道 / 代理模式等)
#
# 修改后重启服务生效:
#   su -c "sh /data/adb/modules/sing-box_module/scripts/sing-box.service restart"
# ============================================================

# ---------- 路径 (一般不需要修改) ----------
# 数据目录: 用户配置、内核二进制、日志均存放于此
sing_box_path="/data/adb/sing-box_module"
bin_name="sing-box"
bin_path="${sing_box_path}/bin/${bin_name}"
run_path="${sing_box_path}/run"
# 用户设置位于 scripts/；完整 sing-box 配置位于 config/local 或 config/remote。
# 模块始终从当前选中配置生成 config/run/config.json，用户源文件不会被修改。

# ---------- 内核渠道 ----------
# 内核二进制来源 (可由 [执行] 菜单 / WebUI 随时切换):
#   refind-pre          reF1nd/sing-box-releases 最新 pre-release (默认, 自用优先)
#   refind-stable       reF1nd/sing-box-releases 最新稳定版
#   official-stable     SagerNet/sing-box 最新稳定版
#   official-pre        SagerNet/sing-box 最新 pre-release
kernel_channel="refind-pre"
# 目标 ABI (安装时由 customize.sh 按设备架构自动设置, 一般不需要手动改)
kernel_abi="arm64-v8a"

# ---------- 代理模式 ----------
# 透明代理模式: tun | mixed | auto_redirect | redirect | tproxy | ebpf | none
#   tun        sing-box 自带 TUN 入站 (gvisor)
#   mixed      同 tun，但使用 mixed
#   auto_redirect  同 tun，但加入 auto_redirect
#   redirect   iptables REDIRECT (仅 TCP, 规则由内置 AndroidTProxyShell 管理)
#   tproxy     iptables TPROXY (TCP+UDP, 规则由内置 AndroidTProxyShell 管理)
#   ebpf       reF1nd fork 的 eBPF 入站 (XDP, 需内核支持)
#   none       不启用透明代理, 仅运行用户配置中的入站
# 模式入站优先读取 /data/adb/sing-box_module/config/inbounds/<proxy_mode>.json；
# 不存在时回退 config/inbounds/tpl/<proxy_mode>.json，并追加到完整配置的 inbounds 数组末尾。
# 两处均不存在同名文件时不插入入站。
# redirect/tproxy 的 listen_port 会与 scripts/tproxy.conf 中的 PROXY_TCP_PORT 保持一致。
proxy_mode="auto_redirect"

# ---------- 分应用代理 ----------
# 是否启用分应用代理（0=关闭，1=开启）。强制代理/强制白名单始终生效。
app_proxy_enable=0
# "whitelist"：仅 proxy_apps_list 中的应用代理；"blacklist"：仅
# bypass_apps_list 中的应用绕过。自动名单仅建议用于 whitelist。
app_proxy_mode="whitelist"
# 是否按预置名单自动生成分应用列表（0=关闭，1=开启）。
auto_proxy_apps_enable=0
# 手动代理名单（whitelist 模式生效），多个包名以空格分隔。
proxy_apps_list=""
# 手动绕过名单（blacklist 模式生效），多个包名以空格分隔。
bypass_apps_list=""
