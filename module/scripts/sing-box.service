#!/system/bin/sh
# ============================================================
# sing-box 服务控制
# 用法: sing-box.service {start|stop|restart}
# 供开机启动脚本 / action.sh / 手动执行调用
# ============================================================

SCRIPTS_DIR=$(dirname "$0")
. "$SCRIPTS_DIR/lib.sh"
load_config

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH"

mkdir -p "$run_path"

# 清理 3 天前的旧日志
find "$sing_box_path" -mtime +3 -type f -name "*.log" -delete 2>/dev/null

log() {
  export TZ=Asia/Shanghai
  now=$(date +"[%Y-%m-%d %H:%M:%S %Z]")
  case $1 in
    Info)  [ -t 1 ] && echo -e "\033[1;32m${now} [Info]: $2\033[0m" || echo "${now} [Info]: $2" ;;
    Warn)  [ -t 1 ] && echo -e "\033[1;33m${now} [Warn]: $2\033[0m" || echo "${now} [Warn]: $2" ;;
    Error) [ -t 1 ] && echo -e "\033[1;31m${now} [Error]: $2\033[0m" || echo "${now} [Error]: $2" ;;
    *)     [ -t 1 ] && echo -e "\033[1;30m${now} [$1]: $2\033[0m" || echo "${now} [$1]: $2" ;;
  esac
}

CONFIG_BUILDER="$SCRIPTS_DIR/config-builder.sh"
TPROXY_ADAPTER="$SCRIPTS_DIR/tproxy.sh"
START_MAX_ATTEMPTS=2
START_CHECK_SECONDS=2

prepare_runtime_config() {
  if ! sh "$CONFIG_BUILDER" build; then
    log Error "运行配置生成失败"
    return 1
  fi
  if ! "$bin_path" check --disable-color -c "$runtime_config_path" \
    >>"$run_path/${bin_name}.log" 2>&1; then
    log Error "配置检查失败, 未启动 ${bin_name}"
    return 1
  fi
}

wait_for_exit() { # $1=pid, $2=timeout seconds
  _pid=$1
  _timeout=$2
  _wait=0
  while kill -0 "$_pid" 2>/dev/null; do
    [ "$_wait" -ge "$_timeout" ] && return 1
    sleep 1
    _wait=$((_wait + 1))
  done
}

stop_core() {
  service_running || return 0

  _pid=$(cat "$service_pid_file")
  kill -15 "$_pid" 2>/dev/null
  if ! wait_for_exit "$_pid" 5; then
    log Warn "${bin_name} 未在 5 秒内停止 (pid $_pid), 强制结束"
    kill -9 "$_pid" 2>/dev/null
  fi
  if ! wait_for_exit "$_pid" 2; then
    log Error "${bin_name} 未能停止 (pid $_pid), 保留 PID 状态"
    return 1
  fi

  rm -f "$service_pid_file"
}

wait_for_core_start() { # $1=pid
  _pid=$1
  _wait=0
  while [ "$_wait" -lt "$START_CHECK_SECONDS" ]; do
    kill -0 "$_pid" 2>/dev/null || return 1
    sleep 1
    _wait=$((_wait + 1))
  done
  kill -0 "$_pid" 2>/dev/null && service_process_matches "$_pid"
}

start_core() {
  _attempt=1
  mv "$run_path/${bin_name}.log" "$run_path/${bin_name}.log.bak" >/dev/null 2>&1
  : >"$run_path/${bin_name}.log" || {
    log Error "无法写入 ${bin_name} 日志"
    return 1
  }

  while [ "$_attempt" -le "$START_MAX_ATTEMPTS" ]; do
    nohup "$bin_path" run --disable-color -c "$runtime_config_path" -D "$run_path" \
      >>"$run_path/${bin_name}.log" 2>&1 &
    _pid=$!
    if wait_for_core_start "$_pid"; then
      if printf '%s\n' "$_pid" >"$service_pid_file"; then
        return 0
      fi
      log Error "无法写入 ${bin_name} PID 文件"
      kill -15 "$_pid" 2>/dev/null
      wait_for_exit "$_pid" 2 || kill -9 "$_pid" 2>/dev/null
      return 1
    fi

    # A surviving but mismatched child is not a usable core and must not make
    # wait block forever before the retry.
    if kill -0 "$_pid" 2>/dev/null; then
      kill -15 "$_pid" 2>/dev/null
      wait_for_exit "$_pid" 2 || kill -9 "$_pid" 2>/dev/null
    fi
    wait "$_pid" 2>/dev/null
    if [ "$_attempt" -lt "$START_MAX_ATTEMPTS" ]; then
      log Warn "${bin_name} 启动未就绪, 1 秒后重试 ($_attempt/$START_MAX_ATTEMPTS)"
      sleep 1
    fi
    _attempt=$((_attempt + 1))
  done

  log Error "${bin_name} 启动失败, 查看 $run_path/${bin_name}.log"
  return 1
}

start_bin() {
  _runtime_prepared=${1:-0}
  if service_running; then
    log Warn "${bin_name} 已在运行, 跳过启动"
    return 0
  fi

  if [ ! -f "$bin_path" ]; then
    log Error "未找到内核二进制"
    return 1
  fi
  if ! chmod 755 "$bin_path"; then
    log Error "无法设置内核二进制权限"
    return 1
  fi

  # 用户源配置从不被修改；仅对派生运行配置做校验。
  [ "$_runtime_prepared" = "1" ] || prepare_runtime_config || return 1

  log Info "starting ${bin_name} service."
  ulimit -SHn 1000000 2>/dev/null || log Warn "无法提高文件描述符上限, 使用系统限制"
  start_core || return 1

  # Rules are installed only after the core has passed its startup check.
  if ! sh "$TPROXY_ADAPTER" start; then
    log Error "透明代理规则装载失败, 回滚核心进程"
    sh "$TPROXY_ADAPTER" stop || log Error "透明代理规则回滚失败"
    stop_core || log Error "核心进程回滚失败"
    return 1
  fi

  (
    sh "$SCRIPTS_DIR/google-firewall-fixer.sh" apply \
      >>"$run_path/run.log" 2>>"$run_path/run_error.log"
  ) &

  rm -f "$run_path/.config-changed"
  date '+%Y-%m-%d %H:%M:%S' > "$run_path/.start_marker" 2>/dev/null
  log Info "${bin_name} 已启动 (pid $(cat "$service_pid_file"))"
  return 0
}

stop_service() {
  log Warn "stopping ${bin_name} service."
  if ! stop_core; then
    log Error "核心进程停止失败, 保留透明代理规则"
    return 1
  fi
  if ! sh "$TPROXY_ADAPTER" stop; then
    log Error "透明代理规则清理失败"
    return 1
  fi
  return 0
}

case "$1" in
  start)
    start_bin
    ;;
  stop)
    stop_service
    ;;
  restart)
    _runtime_prepared=0
    if service_running; then
      prepare_runtime_config || exit 1
      _runtime_prepared=1
      stop_service || exit 1
    fi
    start_bin "$_runtime_prepared"
    ;;
  status)
    if service_running; then
      log Info "${bin_name} 正在运行 (pid $(cat "$service_pid_file"))"
      exit 0
    fi
    log Info "${bin_name} 未运行"
    exit 3
    ;;
  *)
    log Error "用法: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
